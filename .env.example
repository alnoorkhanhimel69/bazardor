# ---- BetterAuth ----
# Generate one with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Your site URL. Local: http://localhost:3000 — Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=
# Optional: database name if it is not part of the URI
MONGODB_DB=

# ---- Social login (optional, the buttons only work when these are set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- API (optional override) ----
# API_BASE_URL=https://api.api-store.workers.dev/api/bazardor
